# Copy this file to ".env" and fill in values as needed.
# The app runs with these defaults even if you change nothing (mock LLM + SQLite).

# --- LLM provider selection ---
# Options: "mock" (no key needed, deterministic) or "gemini"
LLM_PROVIDER=mock

# Google AI Studio free API key -> https://aistudio.google.com/apikey
# Only required when LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# Cheap vs strong routing (Gemini). Set ENABLE_MODEL_ROUTING=false to disable.
ENABLE_MODEL_ROUTING=true
GEMINI_MODEL_CHEAP=gemini-flash-lite-latest
GEMINI_MODEL_STRONG=gemini-flash-latest

# --- Database (tickets / logs) ---
# Default: local SQLite file (zero setup).
DATABASE_URL=sqlite:///./support_triage.db
# Optional: move tickets/logs to Postgres/Supabase later:
# DATABASE_URL=postgresql+psycopg://postgres.<ref>:<password>@<host>:6543/postgres

# --- RAG (knowledge base via Supabase pgvector) ---
# Tickets stay on DATABASE_URL above. RAG uses a separate Postgres URL.
# 1. Create a free Supabase project
# 2. SQL editor: create extension if not exists vector;
# 3. Paste the Transaction pooler URL (port 6543) below
# 4. Set ENABLE_RAG=true and run: python -m app.rag.ingest
ENABLE_RAG=false
RAG_DATABASE_URL=
EMBEDDING_MODEL=gemini-embedding-001

# --- Agent behavior ---
# Max reasoning/tool-call iterations before the loop stops.
MAX_AGENT_STEPS=6

# --- AgentMail (email → triage webhook) ---
# Free tier includes send + receive. Get a key at https://www.agentmail.to
# Then: python -m app.email.setup --webhook-url https://YOUR_STATIC_NGROK/webhooks/agentmail
# Prefer a free static ngrok domain (dashboard.ngrok.com/domains) so the webhook
# URL stays the same across restarts: ngrok http --url=https://NAME.ngrok-free.dev 8000
AGENTMAIL_API_KEY=
AGENTMAIL_INBOX_USERNAME=support-triage
AGENTMAIL_INBOX_ID=
AGENTMAIL_WEBHOOK_SECRET=
# Reply only when guardrails say auto_respond (never on escalate/draft).
AGENTMAIL_AUTO_REPLY=true
