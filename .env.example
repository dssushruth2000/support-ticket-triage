# Copy this file to ".env" and fill in values as needed.
# The app runs with these defaults even if you change nothing (mock LLM + SQLite).

# --- LLM provider selection ---
# Options: "mock" (no key needed, deterministic) or "gemini"
LLM_PROVIDER=mock

# Google AI Studio free API key -> https://aistudio.google.com/apikey
# Only required when LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# Phase 4 — cheap vs strong routing (Gemini). Set ENABLE_MODEL_ROUTING=false to disable.
ENABLE_MODEL_ROUTING=true
GEMINI_MODEL_CHEAP=gemini-flash-lite-latest
GEMINI_MODEL_STRONG=gemini-flash-latest

# --- Database ---
# Default: local SQLite file (zero setup).
DATABASE_URL=sqlite:///./support_triage.db
# To use Supabase/Postgres later, swap to the pooled connection string, e.g.:
# DATABASE_URL=postgresql+psycopg://postgres.<ref>:<password>@<host>:6543/postgres

# --- Agent behavior ---
# Max reasoning/tool-call iterations before the loop stops.
MAX_AGENT_STEPS=6
